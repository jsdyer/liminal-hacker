# Existing encrypted artwork needs the existing deployment's 32-byte base64 key.
# Keep the real value in .env or your host's secret manager. Never commit it.
ART_KEY=
# sites (managed hosting), anonymous (standalone), or proxy (authenticated reverse proxy)
IDENTITY_MODE=anonymous
HOST=127.0.0.1
PORT=4173
DATABASE_PATH=private/journeys.sqlite
# Set this to your HTTPS site origin behind a reverse proxy.
# PUBLIC_ORIGIN=https://liminalhacker.com
# Standalone anonymous mode only: generate a long, random operator key locally.
# ADMIN_TOKEN=
# Trusted reverse-proxy mode only; never expose the Node port to clients.
# ADMIN_USER_IDS=your-authenticated-subject-id
# Sites hosting uses runtime ADMIN_EMAILS instead of the standalone token.
